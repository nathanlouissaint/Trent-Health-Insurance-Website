# Required for persistent lead storage
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Required to send contact-form notifications (leave blank in local UI-only development)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Trent Advisor <inquiries@your-verified-domain.com>"
CONTACT_NOTIFICATION_EMAIL="trent@your-domain.com"
# Set to true only after RESEND_FROM_EMAIL uses a verified custom domain. The
# Resend testing sender (onboarding@resend.dev) cannot send to applicants.
ENABLE_APPLICANT_CONFIRMATION="false"
# Development only: sends the branded confirmation to CONTACT_NOTIFICATION_EMAIL
# instead of the applicant. Ignored outside `next dev`.
APPLICANT_CONFIRMATION_TEST_MODE="false"
# Optional: displayed after a successful request
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/your-advisor/consultation"
# Optional GA4 measurement ID
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
